# رابط الاتصال بقاعدة بيانات PostgreSQL (يلزم PostGIS)
DATABASE_URL="postgresql://user:password@localhost:5432/salon_ai"

# رابط الموقع العام (بدون / في النهاية): يُستخدم للروابط المطلقة في الرسائل والـ sitemap والـ SEO
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# مفتاح توقيع جلسات تسجيل الدخول (JWT). ولّد قيمة عشوائية قوية خاصة بك:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-secret"

# البريد الإلكتروني (Resend). بدونهما تُطبع الرسائل في سجل السيرفر بدل إرسالها.
RESEND_API_KEY=""
EMAIL_FROM="Salon AI <noreply@your-domain.com>"
