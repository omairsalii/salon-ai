# رابط الاتصال بقاعدة بيانات PostgreSQL (يلزم PostGIS)
DATABASE_URL="postgresql://user:password@localhost:5432/salon_ai"
# على Vercel/Supabase: رابط pooler (منفذ 6543) + ?pgbouncer=true&connection_limit=1، وDIRECT_URL للهجرات فقط (انظر DEPLOY.md)
DIRECT_URL=""

# رابط الموقع العام (بدون / في النهاية): يُستخدم للروابط المطلقة في الرسائل والـ sitemap والـ SEO
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# مفتاح توقيع جلسات تسجيل الدخول (JWT). ولّد قيمة عشوائية قوية خاصة بك:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-secret"

# تخزين الصور (Supabase Storage). المفتاح service_role سرّي: للسيرفر فقط ولا يُنشر أبدًا.
# Project Settings > API: رابط المشروع + مفتاح service_role. الحاوية تُنشأ تلقائيًا.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="salon-media"

# البريد الإلكتروني (Resend). بدونهما تُطبع الرسائل في سجل السيرفر بدل إرسالها.
RESEND_API_KEY=""
EMAIL_FROM="Salon AI <noreply@your-domain.com>"
