# رابط الاتصال بقاعدة بيانات PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/salon_ai"

# يستخدم في app/[locale]/page.tsx لبناء رابط مطلق عند جلب /api/salons من السيرفر
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# رمز مؤقت لحماية عمليات الكتابة الإدارية (مثل إنشاء صالون جديد) بانتظار
# نظام مصادقة كامل. ولّد قيمة عشوائية قوية، لا تستخدم هذا المثال كما هو.
ADMIN_API_TOKEN="change-me-to-a-long-random-secret"

# مفتاح توقيع جلسات تسجيل الدخول (JWT). ولّد قيمة عشوائية قوية خاصة بك، مثلاً:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-secret"
