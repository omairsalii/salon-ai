generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String        @db.VarChar(255)
  city            String?       @db.VarChar(100)
  subdomain       String?       @unique @db.VarChar(100)
  customDomain    String?       @map("custom_domain") @db.VarChar(255)
  defaultLanguage String?       @default("ar") @map("default_language") @db.VarChar(10)
  timezone        String?       @default("UTC") @db.VarChar(50)
  currency        String?       @default("BHD") @db.VarChar(10)
  latitude        Decimal?      @db.Decimal(10, 8)
  longitude       Decimal?      @db.Decimal(11, 8)
  addressText     String?       @map("address_text")
  bookingPolicy   String?       @default("DEPOSIT_REQUIRED") @map("booking_policy") @db.VarChar(50)
  workingHoursText String?      @map("working_hours_text")
  description     Json?         @db.JsonB
  phone           String?       @db.VarChar(50)
  isPublished     Boolean       @default(true) @map("is_published")
  depositPercentage Int         @default(30) @map("deposit_percentage")
  minBookingNoticeHours Int     @default(2) @map("min_booking_notice_hours")
  createdAt       DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?     @updatedAt @map("updated_at") @db.Timestamp(6)

  owner           Owner?
  staff           Staff[]
  customers       Customer[]
  services        Service[]
  appointments    Appointment[]
  customerPackages CustomerPackage[]
  offers          Offer[]

  @@map("tenants")
}

model Offer {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  type               String    @db.VarChar(30)
  discountPercent    Int?      @map("discount_percent")
  discountAmount     Decimal?  @map("discount_amount") @db.Decimal(10, 2)
  appliesToServiceId String?   @map("applies_to_service_id") @db.Uuid
  freeServiceId      String?   @map("free_service_id") @db.Uuid
  endsAt             DateTime? @map("ends_at") @db.Timestamp(6)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appliesToService   Service?  @relation("OfferAppliesTo", fields: [appliesToServiceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  freeService        Service?  @relation("OfferFreeService", fields: [freeServiceId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  appointments       Appointment[]

  @@map("offers")
}

model Owner {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("owners")
}

// حساب مالك المنصة — منفصل تمامًا عن Owner (لا يتبع لأي Tenant)
model Admin {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("admins")
}

model Staff {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  name         String        @db.VarChar(255)
  role         String?       @db.VarChar(100)
  phone        String?       @db.VarChar(50)
  status       String        @default("ACTIVE") @db.VarChar(50)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointments Appointment[]

  @@map("staff")
}

model Customer {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  accountId        String?           @map("account_id") @db.Uuid
  name             String            @db.VarChar(255)
  phone            String?           @db.VarChar(50)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(6)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account          CustomerAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  appointments     Appointment[]
  customerPackages CustomerPackage[]

  @@map("customers")
}

// حساب دخول العميل — عابر للصالونات، منفصل عن Customer (سجل CRM خاص بكل
// صالون على حدة). شخص واحد يقدر يكون له أكثر من سجل Customer (وحد بكل
// صالون حجز فيه)، كلها مرتبطة بنفس CustomerAccount عبر accountId.
model CustomerAccount {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String     @db.VarChar(255)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(6)

  customers    Customer[]

  @@map("customer_accounts")
}

model Service {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String?            @map("tenant_id") @db.Uuid
  name              Json?              @db.JsonB
  description       Json?              @db.JsonB
  basePrice         Decimal?           @map("base_price") @db.Decimal(10, 2)
  baseDurationMinutes Int?             @map("base_duration_minutes")
  pricingModel      String?            @map("pricing_model") @db.VarChar(50)
  visibilitySetting String?            @map("visibility_setting") @db.VarChar(50)
  createdAt         DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  options           ServiceOption[]
  pricingRules      ServicePricingRule[]
  appointments      Appointment[]
  customerPackages  CustomerPackage[]
  offersAppliesTo   Offer[]            @relation("OfferAppliesTo")
  offersFree        Offer[]            @relation("OfferFreeService")

  @@map("services")
}

model ServiceOption {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId   String?   @map("service_id") @db.Uuid
  optionName  Json?     @map("option_name") @db.JsonB
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  service     Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("service_options")
}

model ServicePricingRule {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId              String?   @map("service_id") @db.Uuid
  optionValue            String?   @map("option_value") @db.VarChar(100)
  additionalPrice        Decimal?  @map("additional_price") @db.Decimal(10, 2)
  additionalDurationMins Int?      @map("additional_duration_minutes")
  bufferTimeMins         Int?      @default(15) @map("buffer_time_minutes")

  service                Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("service_pricing_rules")
}

model Appointment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  customerId    String?   @map("customer_id") @db.Uuid
  employeeId    String?   @map("employee_id") @db.Uuid
  serviceId     String?   @map("service_id") @db.Uuid
  appliedOfferId String?  @map("applied_offer_id") @db.Uuid
  status        String?   @db.VarChar(50)
  totalAmount   Decimal?  @map("total_amount") @db.Decimal(10, 2)
  depositAmount Decimal?  @map("deposit_amount") @db.Decimal(10, 2)
  paymentStatus String?   @map("payment_status") @db.VarChar(50)
  startTime     DateTime? @map("start_time") @db.Timestamp(6)
  endTime       DateTime? @map("end_time") @db.Timestamp(6)
  holdExpiresAt DateTime? @map("hold_expires_at") @db.Timestamp(6)

  appliedOffer  Offer?    @relation(fields: [appliedOfferId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service       Service?  @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  employee      Staff?    @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("appointments")
}

model CustomerPackage {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String?   @map("tenant_id") @db.Uuid
  customerId        String?   @map("customer_id") @db.Uuid
  serviceId         String?   @map("service_id") @db.Uuid
  packageName       Json?     @map("package_name") @db.JsonB
  price             Decimal?  @db.Decimal(10, 2)
  status            String?   @default("ACTIVE") @db.VarChar(50)
  totalSessions     Int?      @map("total_sessions")
  remainingSessions Int?      @map("remaining_sessions")
  expiresAt         DateTime? @map("expires_at") @db.Date
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  tenant            Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  service           Service?  @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer          Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("customer_packages")
}